  "info": {
    "_postman_id": "fc907c03-df07-45dc-b477-723f287afb0c",
    "name": "Microsoft Graph Excel Charts Worksheets API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Microsoft Graph Excel API provides REST access to Excel workbooks stored in OneDrive, SharePoint, or Teams. Supports reading and writing cell values, executing formulas, managing worksheets, creating charts and tables, and running workbook sessions for transactional batch operations on Excel files.\n\nContact Support:\n Name: Microsoft Graph Support",
      "type": "text/plain"
    }
  }
